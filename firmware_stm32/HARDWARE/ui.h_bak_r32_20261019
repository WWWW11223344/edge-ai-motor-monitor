#ifndef __UI_H
#define __UI_H  /* 防止重复包含 */

#include "stm32f4xx.h"  /* 标准外设库声明 */

/* ==========================================================================
 * 显示界面层（第 3 步要搭的"多行数据框架"）
 * --------------------------------------------------------------------------
 * 设计意图：
 *   把"屏幕上要显示什么"和"数据从哪来"彻底分开。
 *   - 传感器代码只负责往 UI_Data 这个结构体里填数；
 *   - 显示代码只负责把 UI_Data 画到屏上。
 *
 *   所以后面接入转速、电流传感器时，**只需要改填数据的那几行**，
 *   显示部分一行都不用动。
 *
 * 屏幕布局（128x64，共 8 页，每页 8 行像素）：
 *   页 0~1   8x16 字号   Spd  xxxxx  rpm      <- 转速（大字号，答辩时一眼能看见）
 *   页 2~3   8x16 字号   Cur  x.xx   A        <- 电流
 *   页 4~5   8x16 字号   R    xx.x   rpm/V  <- 转速/电压比（归一化转速）
 *   页 6     6x8  字号   Bat xx.xV  ST:XXXXX  <- 母线电压 + 状态
 *   页 7     6x8  字号   SIM  Lx:yy%  T xxxxxxs |  <- 档位 + 运行秒数 + 心跳
 *
 * 为什么用"两种字号混排"：
 *   8x16 一个字占两页，全屏最多放 4 个大字号行。
 *   所以把最重要的两个（转速/电流）用大字号，次要的两个（母线电压/状态）用小字号；
 *   振动行移除后第 4~5 页空出来，留给后续的电流波形信息。
 *
 * 第 6 页左边那格原来画的是假的相似度（Sim 0.95），
 * 第 4 步补充里换成了**真实的母线电压**（Bat 12.4 V）——
 * 假数据留着不如把位置让给真数据，相似度到第 8 步再挪回来。
 * ========================================================================== */

/* 系统状态码 */
#define UI_ST_STOP      0U      /* 停机 */
#define UI_ST_RUN       1U      /* 数据有效且有转动反馈，非 AI 健康判定 */
#define UI_ST_WARN      2U      /* 传感器或转动反馈无效 */
#define UI_ST_ALARM     3U      /* 预留：当前未接入模型或超限报警判据 */

/* 电机档位号：0~1 是固定占空比，2 是"自动扫描启动临界点"。
 * ui.c 靠这个值决定底条那一格画什么，所以必须和 main.c 的 LEVEL_SCAN 一致。 */
#define UI_LEVEL_SCAN   2U

/* 屏幕要显示的全部数据。
 * 后面每接一路传感器，就往这里多填一个字段。 */
typedef struct
{
    float    speed_rpm;     /* 转速，单位 转/分 */
    uint8_t  speed_valid;    /* 1 = 转速可信（停转，或有编码器反馈） */
    float    current_a;     /* 电流，单位 A */
    float    vbat_v;        /* 母线（电池）电压，单位 V —— 来自 PA4 的 1/11 分压 */
    uint8_t  current_valid;  /* 1 = 电流可信；0 = 屏上显示无效标记 */
    uint8_t  vbat_valid;     /* 1 = 母线电压可信；0 = 屏上显示无效标记 */
    float    r_ratio;       /* 归一化转速 R = 转速 / 母线电压，单位 rpm/V */
    uint8_t  r_valid;       /* 1 = R 可信（电机在转且电压通路正常） */
    uint8_t  r_fill;        /* R 窗口已攒点数 0 ~ 16，满 16 才能送 AI */
    float    similarity;    /* 模型结果预留，未接入模型时为 0，不作为状态判据 */
    uint8_t  state;         /* 状态码，取 UI_ST_xxx */
    uint8_t  demo;          /* 1 = 含 SIM 标记；传感器有效性另由各 valid 位标 */
    uint8_t  ai_phase;      /* 0=off/na, 1=AI learning, 2=AI detecting (NEAI 板端) */
    uint8_t  level;         /* 电机测试档位号（0 ~ UI_LEVEL_SCAN），显示在底条上 */
    uint8_t  duty;          /* 当前档位对应的 PWM 占空比，单位 %。
                             * 注意：L2 档时这里填的是"扫描找到的启动临界占空比" */
    uint32_t uptime_s;      /* 上电运行时间，单位 秒 */
} UI_Data;

void UI_Init(void);                     /* 初始化 OLED 并画好固定标签 */
void UI_DrawFrame(void);                /* 只重画不变化的标签（清屏后调用） */
void UI_Update(const UI_Data *d);       /* 每次刷新一个数值区域，轮流覆盖全部区域 */

#endif
